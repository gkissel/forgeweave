# and affixed cobalt pickaxe holding a real Apotheosis gem, a supremium pickaxe with a Mystical
# Agriculture augment, and an atomic matter alloy pickaxe with a Mekanism energy unit installed.
# Taken from the 1.0.0 manual playtest (beta.12 world, 2026-10-26). Barrels sit at z=8, clear of the
# corpus chests (z=0) and block entities (z=4).
setblock 0 -60 8 minecraft:barrel{Items:[{count: 1, Slot: 0b, components: {"forgeweave:modifiers": [{level: 2, id: "forgeweave:socketed"}], "forgeweave:sockets": [{item: {components: {"apotheosis:gem": "apotheosis:core/ballast", "apotheosis:purity": "flawless"}, count: 1, id: "apotheosis:gem"}, slot: 0}], "minecraft:damage": 17, "forgeweave:tool_materials": {head: "forgeweave:cobalt", parts: ["forgeweave:cobalt", "forgeweave:wood", "forgeweave:wood"], binding: "forgeweave:wood", handle: "forgeweave:wood"}, "apotheosis:rarity": "apotheosis:rare", "apotheosis:affixes": {"apotheosis:breaker/ability/enlightened": 0.5f}}, id: "forgeweave:pickaxe"}, {count: 1, Slot: 1b, components: {"forgeweave:modifiers": [{level: 2, id: "forgeweave:reinforced"}], "mysticalagriculture:equipped_augments": [{id: "mysticalagriculture:mining_aoe_1", slot: 0}], "forgeweave:tool_materials": {head: "forgeweave:supremium", parts: ["forgeweave:supremium", "forgeweave:supremium", "forgeweave:supremium"], binding: "forgeweave:supremium", handle: "forgeweave:supremium"}}, id: "forgeweave:pickaxe"}, {count: 1, Slot: 2b, components: {"mekanism:module_container": {enchantments: {levels: {}}, modules: [{type: {type: "mekanism:energy_unit", amount: 4}}]}, "forgeweave:energy": 41250, "forgeweave:tool_materials": {head: "forgeweave:atomic_matter_alloy", parts: ["forgeweave:atomic_matter_alloy", "forgeweave:atomic_matter_alloy", "forgeweave:atomic_matter_alloy"], binding: "forgeweave:atomic_matter_alloy", handle: "forgeweave:atomic_matter_alloy"}}, id: "forgeweave:pickaxe"}]} replace

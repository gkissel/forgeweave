{
  "multipart": [
    {
      "apply": {
        "model": "forgeweave:block/channel/center"
      },
      "when": {
        "down": "false"
      }
    },
    {
      "apply": {
        "model": "forgeweave:block/channel/center_out"
      },
      "when": {
        "down": "true"
      }
    },
    {
      "apply": {
        "model": "forgeweave:block/channel/side",
        "uvlock": true
      },
      "when": {
        "north": "none"
      }
    },
    {
      "apply": {
        "model": "forgeweave:block/channel/side_in",
        "uvlock": true
      },
      "when": {
        "north": "in"
      }
    },
    {
      "apply": {
        "model": "forgeweave:block/channel/side_out",
        "uvlock": true
      },
      "when": {
        "north": "out"
      }
    },
    {
      "apply": {
        "model": "forgeweave:block/channel/side",
        "uvlock": true,
        "y": 180
      },
      "when": {
        "south": "none"
      }
    },
    {
      "apply": {
        "model": "forgeweave:block/channel/side_in",
        "uvlock": true,
        "y": 180
      },
      "when": {
        "south": "in"
      }
    },
    {
      "apply": {
        "model": "forgeweave:block/channel/side_out",
        "uvlock": true,
        "y": 180
      },
      "when": {
        "south": "out"
      }
    },
    {
      "apply": {
        "model": "forgeweave:block/channel/side",
        "uvlock": true,
        "y": 270
      },
      "when": {
        "west": "none"
      }
    },
    {
      "apply": {
        "model": "forgeweave:block/channel/side_in",
        "uvlock": true,
        "y": 270
      },
      "when": {
        "west": "in"
      }
    },
    {
      "apply": {
        "model": "forgeweave:block/channel/side_out",
        "uvlock": true,
        "y": 270
      },
      "when": {
        "west": "out"
      }
    },
    {
      "apply": {
        "model": "forgeweave:block/channel/side",
        "uvlock": true,
        "y": 90
      },
      "when": {
        "east": "none"
      }
    },
    {
      "apply": {
        "model": "forgeweave:block/channel/side_in",
        "uvlock": true,
        "y": 90
      },
      "when": {
        "east": "in"
      }
    },
    {
      "apply": {
        "model": "forgeweave:block/channel/side_out",
        "uvlock": true,
        "y": 90
      },
      "when": {
        "east": "out"
      }
    }
  ]
}
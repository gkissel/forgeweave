    nbt: {
        components: {
            "forgeweave:modifiers": [
                {
                    id: "forgeweave:socketed",
                    level: 3
                }
            ],
            "forgeweave:sockets": [
                {
                    item: {
                        count: 1,
                        id: "minecraft:diamond"
                    },

                },
                {
                    item: {
                        count: 1,
                        id: "minecraft:diamond"
                    },
                    slot: 2
                }
            ],
            "forgeweave:tool_materials": {
                binding: "forgeweave:wood",
                handle: "forgeweave:wood",
                head: "forgeweave:iron"
            },
            "forgeweave:tool_stats": {
                attack_damage: 3.5f,
                durability: 250,
                mining_speed: 6.0f
